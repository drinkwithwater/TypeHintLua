-- Compatibility helper for callers of TestCase.go. The canonical suite is test.py.
const Runtime = require "thlua.runtime.CodeRuntime"
const CodeEnv = require "thlua.code.CodeEnv"
(@do
	let.test = namespace()
	let.clazz = import("thlua.class").clazz
end)

const TestCase = {}
TestCase.__index = TestCase

function:class(test.Case) TestCase.new(vScript:String)
	const expected:Dict(Integer, Integer) = {}
	const severity = {E=1, W=2, I=3, H=4}
	local lineNumber = 0
	for line in (vScript.."\n"):gmatch("(.-)\n") do
		lineNumber = lineNumber + 1
		const marker = line:match("%-%-([EWIH])%s*$") or line:match("%-%-([EWIH]):")
		if marker then expected[lineNumber] = severity[marker]! end
	end
	const self = setmetatable({.class
		_expected = expected,
		_runtime = nil @! clazz.CodeRuntime,
	}, TestCase)
	self._runtime = Runtime.new({
		searchPath=function(vPrefix, vPath)
			error("TestCase.go only supports single-file cases; use test.py for projects")
		end,
		parseFile=function(vFileName)
			assert(vFileName == "[test]", "unexpected file in single-file case")
			return CodeEnv.new(vScript, vFileName)
		end,
		parseGlobal=function(vPackage)
			const name = "@virtual-file:"..vPackage
			return CodeEnv.new(require("thlua.global."..vPackage), name), name
		end,
		createAsync=function.nocheck(fn)
			return require("luv").new_async(fn)
		end,
		print=function(...) end,
	})
	return self
end

function TestCase:getRuntime()
	return self._runtime
end

function TestCase.go(vScript:String, vName:OrNil(String))
	const case = TestCase.new(vScript)
	const runtime = case:getRuntime()
	const failures:List(String) = {}
	local complete = false @ Boolean
	runtime:promiseMain("[test]"):next@<Nil>(function(_)
		const seen:Dict(Integer, True) = {}
		for _, list in pairs(runtime:getAllDiagnostic()) do
			for _, diagnostic in ipairs(list) do
				const line = diagnostic.node.l
				if diagnostic.node.path ~= "[test]" or case._expected[line] ~= diagnostic.severity then
					failures[#failures + 1] = tostring(diagnostic.node)..": "..diagnostic.msg
				else
					seen[line] = true
				end
			end
		end
		for line, _ in pairs(case._expected) do
			if not seen[line] then
				failures[#failures + 1] = "line "..line..": expected diagnostic missing"
			end
		end
		complete = true
	end, function(reason)
		failures[#failures + 1] = tostring(reason)
		complete = true
	end):forget()
	require("luv").run()
	assert(complete, "test did not finish: "..(vName or "[test]"))
	assert(#failures == 0, (vName or "[test]").."\n"..table.concat(failures, "\n"))
end

return TestCase
