const class = require@<let.clazz> "thlua.class"

const FrozenTypeSet = {}
FrozenTypeSet.__index = FrozenTypeSet

function:class(clazz.FrozenTypeSet) FrozenTypeSet.new(vManager:clazz.TypeManager, vBuilder:clazz.HashableTypeSet)
	assert(vBuilder:getManager() == vManager, "type set belongs to another TypeManager")
	const self = setmetatable({.class
		_typeManager = vManager,
		_typeDict = {} @ Dict(Integer, clazz.IAtomType),
		_typeResult = false @ OrFalse(clazz.UAtomUnion),
		_num = vBuilder:getNum(),
		_hash = vBuilder:getHash(),
	}, FrozenTypeSet)
	vBuilder:foreach(function(vAtom)
		self._typeDict[vAtom.id] = vAtom
	end)
	return self
end

function FrozenTypeSet:sameMembers(vBuilder:clazz.HashableTypeSet):Ret(Boolean)
	if vBuilder:getManager() ~= self._typeManager or vBuilder:getNum() ~= self._num then
		return false
	end
	for _, v in pairs(self._typeDict) do
		if not vBuilder:findAtom(v) then
			return false
		end
	end
	return true
end

function FrozenTypeSet:foreach(vFunc:Fn(clazz.IAtomType))
	for _, v in pairs(self._typeDict) do
		vFunc(v)
	end
end

-- Return only atoms, never the private dictionary as iterator state.
function FrozenTypeSet:atoms():Ret(Fn():Ret(OrNil(clazz.IAtomType)))
	local nKey:OrNil(Integer) = nil
	return function()
		const nNextKey, nAtom = next(self._typeDict, nKey)
		nKey = nNextKey
		return nAtom
	end
end

function FrozenTypeSet:findAtom(vAtom:clazz.IAtomType):Ret(OrFalse(clazz.IAtomType))
	return self._typeDict[vAtom.id] == vAtom and vAtom or false
end

-- These operations compare member identity, not semantic subtyping.
function FrozenTypeSet:containsSet(vRight:clazz.FrozenTypeSet):Ret(Boolean)
	assert(vRight:getManager() == self._typeManager, "type set belongs to another TypeManager")
	for nAtom in vRight:atoms() do
		if not self:findAtom(nAtom) then
			return false
		end
	end
	return true
end

function FrozenTypeSet:unionSet(vRight:clazz.FrozenTypeSet):Ret(clazz.FrozenTypeSet)
	const nBuilder = self._typeManager:HashableTypeSet()
	nBuilder:putSet(self)
	nBuilder:putSet(vRight)
	return self._typeManager:unifyTypeSet(nBuilder)
end

function FrozenTypeSet:intersectSet(vRight:clazz.FrozenTypeSet):Ret(clazz.FrozenTypeSet)
	assert(vRight:getManager() == self._typeManager, "type set belongs to another TypeManager")
	const nBuilder = self._typeManager:HashableTypeSet()
	for nAtom in self:atoms() do
		if vRight:findAtom(nAtom) then
			nBuilder:putAtom(nAtom)
		end
	end
	return self._typeManager:unifyTypeSet(nBuilder)
end

function FrozenTypeSet:subtractSet(vRight:clazz.FrozenTypeSet):Ret(clazz.FrozenTypeSet)
	assert(vRight:getManager() == self._typeManager, "type set belongs to another TypeManager")
	const nBuilder = self._typeManager:HashableTypeSet()
	for nAtom in self:atoms() do
		if not vRight:findAtom(nAtom) then
			nBuilder:putAtom(nAtom)
		end
	end
	return self._typeManager:unifyTypeSet(nBuilder)
end

function FrozenTypeSet:getDict()
	const nCopy = {} @ Dict(Integer, clazz.IAtomType)
	for k,v in pairs(self._typeDict) do
		nCopy[k] = v
	end
	return nCopy
end

function FrozenTypeSet:getManager()
	return self._typeManager
end

function FrozenTypeSet:getNum()
	return self._num
end

function FrozenTypeSet:getHash()
	return self._hash
end

function FrozenTypeSet:getResultType():Ret(OrFalse(clazz.UAtomUnion))
	return self._typeResult
end

-- Manager publication only. Membership is immutable while this cache fills.
function FrozenTypeSet:_cacheResult(vType:clazz.UAtomUnion)
	assert((vType @? clazz.BaseReadyType)._typeManager == self._typeManager, "type belongs to another TypeManager")
	assert(not self._typeResult or self._typeResult == vType, "type result already published")
	self._typeResult = vType
end

function FrozenTypeSet:_buildType():Ret(clazz.UAtomUnion)
	local nResult = self._typeResult
	if not nResult then
		if self._num == 1 then
			const _, nAtom = next(self._typeDict)
			nResult = assert(nAtom)
		else
			const nCollection = self._typeManager:TypeCollection()
			self:foreach(function(vAtom)
				nCollection:put(vAtom)
			end)
			nResult = nCollection:mergeToAtomUnion()
		end
		-- Another task may have normalized the same snapshot while this one
		-- waited on structural relations. Keep the first published result.
		if not self._typeResult then
			self:_cacheResult(nResult)
		end
		nResult = self._typeResult @> clazz.UAtomUnion
	end
	return nResult
end

return FrozenTypeSet
