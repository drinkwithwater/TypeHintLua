const class = require@<let.clazz> "thlua.class"
const FrozenTypeSet = require "thlua.type.FrozenTypeSet"

-- Mutable identity collection. Only frozen snapshots cache normalized types.
const HashableTypeSet = {}
HashableTypeSet.__index = HashableTypeSet

function:class(clazz.HashableTypeSet) HashableTypeSet.new(vManager:clazz.TypeManager)
	return setmetatable({.class
		_typeManager = vManager,
		_typeDict = {} @ Dict(Integer, clazz.IAtomType),
		_num = 0 @ Integer,
		_addValue = 0 @ Integer,
		_xorValue = 0 @ Integer,
		_hash = 0 @ Integer,
	}, HashableTypeSet)
end

function HashableTypeSet:putSet(vTypeSet:clazz.FrozenTypeSet)
	assert(vTypeSet:getManager() == self._typeManager, "type set belongs to another TypeManager")
	vTypeSet:foreach(function(vAtom)
		self:putAtom(vAtom)
	end)
end

function HashableTypeSet:initFromUnion(vUnionType:clazz.IUnionType)
	self:putType(vUnionType)
end

function HashableTypeSet:initFromAtom(vAtomType:clazz.IAtomType)
	self:putAtom(vAtomType)
end

function HashableTypeSet:putType(vType:clazz.UAtomUnion)
	assert(vType:getManager() == self._typeManager, "type belongs to another TypeManager")
	vType:foreach(function(vAtom)
		self:putAtom(vAtom)
	end)
end

function HashableTypeSet:putAtom(vAtomType:clazz.IAtomType):Ret(Boolean)
	-- BaseAtomType interns during construction, before class attaches its metatable.
	assert((vAtomType @? clazz.BaseReadyType)._typeManager == self._typeManager, "type belongs to another TypeManager")
	const nId = vAtomType.id
	assert(nId > 0, "type set requires an initialized atom")
	-- Constructing atoms do not have methods yet. Published unions do.
	assert(not vAtomType.isUnion or not vAtomType:isUnion(), "type set requires an atom, not a union")
	const nOld = self._typeDict[nId]
	if nOld then
		assert(nOld == vAtomType, "type identity collision")
		return false
	end
	self._typeDict[nId] = vAtomType
	self._addValue = self._addValue + nId
	self._xorValue = self._xorValue ^ nId
	self._hash = (self._xorValue << 32) + self._addValue
	self._num = self._num + 1
	return true
end

function HashableTypeSet:foreach(vFunc:Fn(clazz.IAtomType))
	for _, v in pairs(self._typeDict) do
		vFunc(v)
	end
end

-- Return only atoms, never the private dictionary as iterator state.
function HashableTypeSet:atoms():Ret(Fn():Ret(OrNil(clazz.IAtomType)))
	local nKey:OrNil(Integer) = nil
	return function()
		const nNextKey, nAtom = next(self._typeDict, nKey)
		nKey = nNextKey
		return nAtom
	end
end

function HashableTypeSet:findAtom(vAtom:clazz.IAtomType):Ret(OrFalse(clazz.IAtomType))
	return self._typeDict[vAtom.id] == vAtom and vAtom or false
end

-- Compatibility snapshot; callers never receive owned storage.
function HashableTypeSet:getDict()
	const nCopy = {} @ Dict(Integer, clazz.IAtomType)
	for k,v in pairs(self._typeDict) do
		nCopy[k] = v
	end
	return nCopy
end

function HashableTypeSet:getManager()
	return self._typeManager
end

function HashableTypeSet:getNum()
	return self._num
end

function HashableTypeSet:getHash()
	return self._hash
end

function HashableTypeSet:frozen()
	return FrozenTypeSet.new(self._typeManager, self)
end

return HashableTypeSet
